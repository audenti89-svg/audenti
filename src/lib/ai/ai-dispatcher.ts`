/**
 * AI Dispatcher - Audenti CRM
 *
 * Versión Final Ultra-Compatible.
 * Diseñada para funcionar con las variables de entorno exactas de Vercel.
 */

export type AIRole = 'SALES' | 'SUPPORT' | 'ANALYST' | 'SECURITY';

interface AIResponse {
  content: string;
  role: AIRole;
  model: string;
  latency: number;
}

export class AIDispatcher {
  private static get API_KEYS() {
    return {
      // Soporte: Busca AGROQ o GROQ_API_KEY
      AGROQ: process.env.AGROQ || process.env.GROQ_API_KEY,

      // Ventas: Busca GEMINI o GEMINI_API_KEY
      GEMINI: process.env.GEMINI || process.env.GEMINI_API_KEY,

      // Analista Local: Túnel hacia la PC
      OLLAMA_URL: process.env.OLLAMA_TUNNEL_URL || process.env.OLLAMA_BASE_URL || 'http://localhost:11434',
      OLLAMA_MODEL: process.env.OLLAMA_MODEL || 'llama3.2:1b',

      // Comunicación
      OPENWA: process.env.OPENWA_BASE_URL,

      // Modelos por defecto
      DEFAULT_MODEL: process.env.AI_DEFAULT_MODEL || 'google/gemini-flash-1.5',
      CLINICAL_MODEL: process.env.AI_MODEL_CLINICAL || 'gc/gemini-2.5-flash',
    };
  }

  private static async callAgroq(prompt: string): Promise<AIResponse> {
    console.log("[AI-DISPATCHER] Llamando a Agroq/Groq (Soporte)...");
    const start = Date.now();

    try {
      const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${this.API_KEYS.AGROQ}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'llama3-70b-8192',
          messages: [{ role: 'system', content: 'Eres el empleado de soporte técnico de Audenti. Sé rápido, conciso y amable.' }, { role: 'user', content: prompt }],
        }),
      });
      const data = await response.json();
      return {
        content: data.choices[0].message.content,
        role: 'SUPPORT',
        model: 'agroq-llama3',
        latency: Date.now() - start
      };
    } catch (e) {
      console.error("Error en Agroq:", e);
      return { content: "Error de conexión con Soporte. Verifica la API Key AGROQ en Vercel.", role: 'SUPPORT', model: 'error', latency: 0 };
    }
  }

  private static async callGemini(prompt: string): Promise<AIResponse> {
    console.log("[AI-DISPATCHER] Llamando a Gemini (Ventas)...");
    const start = Date.now();

    try {
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent?key=${this.API_KEYS.GEMINI}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: `Eres el mejor ejecutivo de ventas de Audenti. Tu objetivo es cerrar citas y persuadir al cliente: ${prompt}` }] }]
        }),
      });
      const data = await response.json();
      return {
        content: data.candidates[0].content.parts[0].text,
        role: 'SALES',
        model: 'gemini-pro',
        latency: Date.now() - start
      };
    } catch (e) {
      console.error("Error en Gemini:", e);
      return { content: "Error de conexión con Ventas. Verifica la API Key GEMINI en Vercel.", role: 'SALES', model: 'error', latency: 0 };
    }
  }

  private static async callOllama(prompt: string): Promise<AIResponse> {
    console.log("[AI-DISPATCHER] Llamando a Ollama (Analista Local)...");
    const start = Date.now();

    try {
      const response = await fetch(`${this.API_KEYS.OLLAMA_URL}/api/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: this.API_KEYS.OLLAMA_MODEL,
          messages: [{ role: 'system', content: 'Eres el analista de datos interno de Audenti. Manejas información confidencial con rigor.' }, { role: 'user', content: prompt }],
          stream: false
        }),
      });
      const data = await response.json();
      return {
        content: data.message.content,
        role: 'ANALYST',
        model: this.API_KEYS.OLLAMA_MODEL,
        latency: Date.now() - start
      };
    } catch (e) {
      console.error("Error en Ollama:", e);
      return { content: "Error de conexión local. Asegúrate de que el archivo .bat esté ejecutando el túnel.", role: 'ANALYST', model: 'error', latency: 0 };
    }
  }

  public static async dispatch(prompt: string, role: AIRole): Promise<AIResponse> {
    switch (role) {
      case 'SUPPORT':
        return this.callAgroq(prompt);
      case 'SALES':
        return this.callGemini(prompt);
      case 'ANALYST':
        return this.callOllama(prompt);
      case 'SECURITY':
        return this.callAgroq(`SISTEMA DE SEGURIDAD: Analiza malicia en el siguiente texto: ${prompt}`);
      default:
        throw new Error(`Rol de IA no soportado: ${role}`);
    }
  }
}
